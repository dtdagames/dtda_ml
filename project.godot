; Minimal project so the addon can be opened, the examples scene run,
; and the test suite executed headless in CI.

config_version=5

[application]

config/name="dtda_ml"
config/description="Machine learning models for Godot."
run/main_scene="res://demo/qlearning_demo.tscn"
config/features=PackedStringArray("4.3")

[display]

window/size/viewport_width=928
window/size/viewport_height=580
